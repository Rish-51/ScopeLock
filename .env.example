# Sentry DSN for metadata-only agent tracing (leave empty to disable telemetry completely)
SENTRY_DSN=

# Ollama API Host (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# ScopeLock Model (default: gemma4:e4b, fallback: gemma3:4b, lightweight: gemma4:e2b)
SCOPELOCK_MODEL=gemma4:e4b

# Context window size in tokens (Ollama default is only 4096; ScopeLock defaults to 16384)
SCOPELOCK_NUM_CTX=16384

# Server Configuration
PORT=8000
HOST=0.0.0.0
